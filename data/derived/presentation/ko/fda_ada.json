              "source_text_sha256": "7a331f07668b976f634bdbc77d2e08d30860a4f51956856600fec63664dbbcfb"
            },
            {
              "record_id": "fda_ada.kr.V_A.001",
              "source_unit_id": "fda_ada.su.5_a.001",
              "source_text_sha256": "9463503344d9f7f3f7069d12e4854f7836a83b590dc75c810e6d7a4e17e33fbc"
            },
            {
              "record_id": "fda_ada.kr.VI_B.005",
              "source_unit_id": "fda_ada.su.6_b.002",
              "source_text_sha256": "bf18e874f6e1ceebfc483587da4e90f5907364051bd263716aac05c5c668822e"
            }
          ],
          "source_support": "synthesized"
        },
        {
          "unit_id": "fda_ada.sem.summary.document_overview.u3",
          "text": "ADA 시험의 수행 및 문서화는 피험자 검체 확보와 채취 시점, 통합 면역원성 요약 보고서를 통한 전주기 관리를 다룬다.",
          "sentence_role": "main_points",
          "evidence_refs": [
