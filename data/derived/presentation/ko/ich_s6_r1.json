      "units": [
        {
          "unit_id": "ich_s6_r1.sem.summary.scope.u1",
          "text": "이 가이드라인은 재조합 DNA 기술, 세포 배양 및 단클론항체로 생산된 단백질·펩타이드 등 생명공학 유래 의약품에 적용된다.",
          "sentence_role": "scope",
          "evidence_refs": [
            {
              "record_id": "ich_s6_r1.kr.1_3.001",
              "source_unit_id": "ich_s6_r1.su.part1.1_3.001",
