      "units": [
        {
          "unit_id": "fda_ada_2014.sem.summary.clinical_risk_mitigation.u1",
          "text": "임상 단계 면역원성 위험 완화는 치료 전 기준선 검체, 위험도별 검체 검사, 이상반응 의심 시 검체 채취, 시험 종료 시 검체 관련 고려사항을 다룬다.",
          "sentence_role": "main_points",
