{
  "scope_profiles_version": "0.1.0",
  "_comment": "Data-driven replacement for the hardcoded table formerly inline in engine/data_store.js deriveRecordScope() (docs/schema.md Model 0.6.0). Behavior-preserving transcription except: (1) document matching is now exact document_id equality instead of substring includes() (docId.includes('s6')/.includes('m10')/.includes('fda')/.includes('ema') — a latent false-positive risk on any future document_id containing those substrings incidentally); (2) topic_rules gained FDA ADA-specific entries appended after all legacy entries, so no legacy record's topic_scope changes — this closes the defect where all 132 FDA ADA KnowledgeRecords fell through to topic_scope='general' with no section-path branch ever matching them.",

  "document_profiles": [
    {
      "document_id": "ich_s6_r1",
      "molecule_scope": "biotechnology",
      "study_context_scope": "nonclinical_safety",
      "assay_technology_scope": "in_vivo_toxicology",
      "explicit_exclusions": ["small_molecule", "atmp"]
    },
    {
      "document_id": "ich_m10",
      "molecule_scope": "all",
      "study_context_scope": "bioanalytical_validation",
      "assay_technology_scope": "none",
      "explicit_exclusions": []
    },
    {
      "document_id": "fda_ada",
      "molecule_scope": "biotechnology",
      "study_context_scope": "clinical_immunogenicity",
      "assay_technology_scope": "ada_multi_tiered",
      "explicit_exclusions": ["nonclinical", "small_molecule", "ivd"]
    },
    {
      "document_id": "ema_fih",
      "molecule_scope": "all",
      "study_context_scope": "early_clinical_fih",
      "assay_technology_scope": "none",
      "explicit_exclusions": ["atmp"]
    }
  ],

  "default_profile": {
    "molecule_scope": "all",
    "study_context_scope": "unknown",
    "assay_technology_scope": "none",
    "explicit_exclusions": []
  },

  "section_assay_rules": [
    {
      "rule_id": "chromatography",
      "when_section_path_includes": "chromatography",
      "assay_technology_scope": "chromatography",
      "explicit_exclusions_add": ["ligand_binding_assay"]
    },
    {
      "rule_id": "ligand_binding",
      "when_section_path_includes": "ligand binding",
      "assay_technology_scope": "ligand_binding_assay",
      "explicit_exclusions_add": ["chromatography"]
    }
  ],

  "topic_rules": [
    { "rule_id": "duration_param", "when_parameter_includes": "duration", "topic_scope": "study_duration" },
    { "rule_id": "accuracy_precision_param", "when_parameter_equals_any": ["accuracy", "precision"], "topic_scope": "acceptance_criteria" },
    { "rule_id": "qcs_param", "when_parameter_includes": "qcs", "topic_scope": "acceptance_criteria" },
    { "rule_id": "species_param", "when_parameter_includes": "species", "topic_scope": "species_selection" },
    { "rule_id": "species_selection_section", "when_section_path_includes": "species selection", "topic_scope": "species_selection" },
    { "rule_id": "species_model_selection_section", "when_section_path_includes": "species/model selection", "topic_scope": "species_selection" },
    { "rule_id": "study_design_section", "when_section_path_includes": "study design", "topic_scope": "study_duration" },
    { "rule_id": "partial_validation_section", "when_section_path_includes": "partial validation", "topic_scope": "partial_validation" },
    { "rule_id": "accuracy_and_precision_section", "when_section_path_includes": "accuracy and precision", "topic_scope": "acceptance_criteria" },
    { "rule_id": "starting_dose_section", "when_section_path_includes": "starting dose", "topic_scope": "starting_dose" },
    { "rule_id": "dose_param", "when_parameter_includes": "dose", "topic_scope": "starting_dose" },

    { "rule_id": "fda_ada_multi_tiered", "when_section_path_includes": "multi-tiered", "topic_scope": "multi_tiered_testing" },
    { "rule_id": "fda_ada_cut_point", "when_section_path_includes": "cut-point", "topic_scope": "cut_point" },
    { "rule_id": "fda_ada_drug_tolerance", "when_section_path_includes": "drug tolerance", "topic_scope": "drug_tolerance" },
    { "rule_id": "fda_ada_neutralization", "when_section_path_includes": "neutralization", "topic_scope": "neutralizing_antibody" },
    { "rule_id": "fda_ada_screening_validation", "when_section_path_includes": "screening assay", "topic_scope": "cut_point" },
    { "rule_id": "fda_ada_confirmatory_validation", "when_section_path_includes": "confirmatory assay", "topic_scope": "cut_point" }
  ],

  "default_topic_scope": "general"
}
