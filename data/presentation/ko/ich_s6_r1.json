      "source_text_sha256": "c4aede8b2df040592301f521b57d08d405f7195a1371480373542081c30bb5ef",
      "normalized_ko": "비인간 영장류(NHP)가 유일한 관련 종인 경우",
      "normalization_status": "reviewed"
    },
    {
      "record_id": "ich_s6_r1.cond.part2_6.001",
