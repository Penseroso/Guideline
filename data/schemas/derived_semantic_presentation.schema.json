{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/regulatory-guideline-archive/derived_semantic_presentation.schema.json",
  "title": "Derived Semantic Presentation Overlay (Korean)",
  "type": "object",
  "additionalProperties": false,
  "required": ["presentation_overlay_version", "language", "document_id", "entries"],
  "properties": {
    "presentation_overlay_version": { "const": "0.2.0" },
    "language": { "const": "ko" },
    "document_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["unreviewed", "needs_review", "reviewed"]
    },
    "sentenceRole": {
      "type": "string",
      "enum": ["definition", "scope", "main_points", "boundary", "exception"]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "source_unit_id", "source_text_sha256"],
      "properties": {
        "record_id": { "$ref": "#/definitions/id" },
        "source_unit_id": { "$ref": "#/definitions/id" },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "text", "sentence_role", "evidence_refs", "source_support"],
      "properties": {
        "unit_id": { "$ref": "#/definitions/id" },
        "text": { "type": "string", "minLength": 1 },
        "sentence_role": { "$ref": "#/definitions/sentenceRole" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/evidenceRef" }
        },
        "source_support": {
          "type": "string",
          "enum": ["direct", "synthesized"]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_id", "language", "summary_spec_sha256", "facet_dispositions", "units", "review_status"],
      "properties": {
        "semantic_id": { "$ref": "#/definitions/id" },
        "language": { "const": "ko" },
        "summary_spec_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "facet_dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["facet_id", "status", "gap_reason"],
            "properties": {
              "facet_id": { "$ref": "#/definitions/id" },
              "status": { "type": "string", "enum": ["covered", "gap"] },
              "gap_reason": {
                "type": ["string", "null"],
                "enum": [null, "no_structured_evidence", "insufficient_support", "verification_failed"]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "covered" } },
                  "required": ["status"]
                },
                "then": { "properties": { "gap_reason": { "type": "null" } } },
                "else": {
                  "properties": {
                    "gap_reason": {
                      "type": "string",
                      "enum": ["no_structured_evidence", "insufficient_support", "verification_failed"]
                    }
                  }
                }
              }
            ]
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/unit" }
        },
        "review_status": { "$ref": "#/definitions/reviewStatus" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "units": {
                "contains": {
                  "properties": { "source_support": { "const": "synthesized" } }
                }
              }
            },
            "required": ["units"]
          },
          "then": {
            "properties": {
              "review_status": {
                "enum": ["needs_review", "reviewed"]
              }
            }
          }
        }
      ]
    }
  }
}
