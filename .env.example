# Copy this file to .env and fill in the key(s) you have. .env is
# gitignored — never commit real keys. engine/llm_client.js picks
# whichever provider has a key set; both may be set at once (e.g. to
# use different providers for extraction vs. verification per
# product_roadmap.md §2.5.1).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# engine/server.js (M5 — npm run serve). All optional; sensible local-first
# defaults apply when unset. Server binds 127.0.0.1 by default and refuses
# to start bound elsewhere unless GUIDELINE_AUTH_TOKEN is set — see
# engine/server.js for why.
GUIDELINE_PORT=8787
GUIDELINE_HOST=127.0.0.1
GUIDELINE_AUTH_TOKEN=
OPTION_B_TIMEOUT_MS=30000
