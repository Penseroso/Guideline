# Copy this file to .env and fill in the key(s) you have. .env is
# gitignored — never commit real keys. engine/llm_client.js picks
# whichever provider has a key set; both may be set at once (e.g. to
# use different providers for extraction vs. verification per
# product_roadmap.md §2.5.1).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The answer router always tries structured evidence first. With one OpenAI
# key it uses different default models for grounded generation and verification.
# With no usable distinct model pair it falls back to verbatim source excerpts.
# Optional per-role overrides:
GUIDELINE_GENERATOR_PROVIDER=
GUIDELINE_GENERATOR_MODEL=
GUIDELINE_VERIFIER_PROVIDER=
GUIDELINE_VERIFIER_MODEL=

# engine/server.js (M5 — npm run serve). All optional; sensible local-first
# defaults apply when unset. Server binds 127.0.0.1 by default and refuses
# to start bound elsewhere unless GUIDELINE_AUTH_TOKEN is set — see
# engine/server.js for why.
GUIDELINE_PORT=8787
GUIDELINE_HOST=127.0.0.1
GUIDELINE_AUTH_TOKEN=
GUIDELINE_ALLOWED_HOSTS=
GUIDELINE_FALLBACK_TIMEOUT_MS=30000

# Full question/answer and feedback logs are enabled by default for the
# coverage workflow. Set false to disable persistence. Paths may point
# outside the repository so deployment-specific file permissions apply.
GUIDELINE_LOG_ENABLED=true
GUIDELINE_QUERY_LOG_PATH=
GUIDELINE_FEEDBACK_LOG_PATH=
