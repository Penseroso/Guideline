{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/regulatory-guideline-archive/condition_binding.schema.json",
  "title": "Condition-to-Context-Predicate Binding (Applicability Layer 0.1.0)",
  "description": "Derived, additive layer. Does NOT modify guideline_bundle.schema.json or any Condition record — a binding only annotates an existing Condition with a machine-evaluable predicate over RegulatoryContext slots, or explicitly marks it as not machine-evaluable. verification_status is deliberately a separate vocabulary from the source archive's review_status (docs/schema.md Applicability Layer 0.1.0): review_status describes a source record's own review state, verification_status describes whether this derived binding passed the automated binding pipeline's gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "bindings"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/definitions/conditionBinding" }
    }
  },
  "definitions": {
    "conditionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "condition_id",
        "bindability",
        "non_bindable_reason",
        "binding_role",
        "predicate",
        "evidence_span",
        "verification_status"
      ],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "condition_id": { "type": "string", "minLength": 1 },
        "bindability": {
          "type": "string",
          "enum": ["bindable", "non_bindable"]
        },
        "non_bindable_reason": {
          "type": ["string", "null"],
          "enum": [
            "epistemic_hedge",
            "discourse_marker",
            "narrative_reference",
            "expert_judgment_required",
            null
          ]
        },
        "binding_role": {
          "type": ["string", "null"],
          "enum": ["full_scope", "partial_scope", "exception", null]
        },
        "predicate": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/predicateGroup" }
          ]
        },
        "evidence_span": { "type": "string", "minLength": 1 },
        "verification_status": {
          "type": "string",
          "enum": ["verified", "needs_review"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "bindability": { "const": "bindable" } },
            "required": ["bindability"]
          },
          "then": {
            "properties": {
              "non_bindable_reason": { "const": null },
              "binding_role": { "enum": ["full_scope", "partial_scope", "exception"] },
              "predicate": { "$ref": "#/definitions/predicateGroup" }
            }
          },
          "else": {
            "properties": {
              "non_bindable_reason": {
                "enum": [
                  "epistemic_hedge",
                  "discourse_marker",
                  "narrative_reference",
                  "expert_judgment_required"
                ]
              },
              "binding_role": { "const": null },
              "predicate": { "const": null }
            }
          }
        }
      ]
    },
    "predicateLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "operator", "value"],
      "properties": {
        "slot": { "type": "string", "minLength": 1 },
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "in", "not_in"]
        },
        "value": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "enum": ["in", "not_in"] } },
            "required": ["operator"]
          },
          "then": {
            "properties": { "value": { "type": "array" } }
          },
          "else": {
            "properties": { "value": { "type": "string" } }
          }
        }
      ]
    },
    "predicateGroup": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/predicateLeaf" }
        },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/predicateLeaf" }
        }
      }
    }
  }
}
